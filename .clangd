CompileFlags:
    Add:
        [
            -std=c++20,
            -Wall,
            -Wextra,
            -Wpedantic,
            -Werror=pedantic,
            -Wconversion,
            -D_XOPEN_SOURCE,
            -Wsign-conversion,
            -Wfloat-equal,
            -Wshadow,
            -Wunreachable-code,
            -fexperimental-library,
            -I/opt/homebrew/include,
            -L/opt/homebrew/opt/llvm/lib/c++,
            -Wl,
            -rpath,
            /opt/homebrew/opt/llvm/lib/c++,
        ]
    Compiler: /opt/homebrew/opt/llvm/bin/clang
Index:
    Background: Skip     # Disable slow background indexing of these files.

InlayHints:
    Enabled: Yes
    ParameterNames: Yes
    DeducedTypes: Yes

Hover:
    ShowAKA: Yes

Diagnostics:
    UnusedIncludes: Strict

---

If:
    PathMatch: [ .*\.c ]
CompileFlags:
    Add:
        [
            -std=c99,
            -Wall,
            -Wextra,
            -Wpedantic,
            -Werror=pedantic,
            -Wconversion,
            -Wsign-conversion,
            -Wfloat-equal,
            -Wshadow,
            -Wunreachable-code,
        ]

Index:
    Background: Skip

InlayHints:
    Enabled: Yes
    ParameterNames: Yes
    DeducedTypes: Yes

Hover:
    ShowAKA: Yes

Diagnostics:
    UnusedIncludes: Strict