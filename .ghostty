shell-integration = zsh

# Font (matching iTerm2)
font-family = "MesloLGS NF"
font-size = 13

# Window size
window-width = 80
window-height = 25

# Theme/UI
theme = vesper

# Saturated ANSI palette (overrides vesper's pastels)
palette = 0=#1c1c1c
palette = 1=#d70000
palette = 2=#00af00
palette = 3=#d7d700
palette = 4=#0087ff
palette = 5=#d700d7
palette = 6=#00d7d7
palette = 7=#d0d0d0
palette = 8=#5f5f5f
palette = 9=#ff0000
palette = 10=#00ff00
palette = 11=#ffff00
palette = 12=#5fafff
palette = 13=#ff00ff
palette = 14=#00ffff
palette = 15=#ffffff
macos-secure-input-indication = false
background = 000000
macos-non-native-fullscreen = true
window-save-state = never
confirm-close-surface = false
macos-titlebar-style = transparent
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor
adjust-cursor-thickness = 15
window-theme = dark

# Keybinds
keybind = cmd+right=next_tab
keybind = cmd+left=previous_tab
keybind = cmd+up=scroll_to_top
keybind = cmd+down=scroll_to_bottom
# Updates
auto-update-channel = tip

